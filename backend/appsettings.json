{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "fridgeExactRoute": { 
        "ClusterId": "fridgeCluster",
        "Match": {
          "Path": "/api/fridge"
        },
        "Transforms": [
          { "PathPattern": "/fridge" }
        ]
      },

      "fridgeWildcardRoute": { 
        "ClusterId": "fridgeCluster",
        "Match": {
          "Path": "/api/fridge/{**catchall}"
        },
        "Transforms": [
          { "PathPattern": "/fridge/{**catchall}" }
        ]
      }
    },
   
    "Clusters": {
      "fridgeCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://thefridge-api.karapincha.io"
          }
        }
      }
    }
  }
}